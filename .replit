modules = ["web", "nodejs-20", "python-3.11", "postgresql-16", "java", "java-graalvm22.3"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "gmp", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "rustc", "tcl", "tk", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MIFARE Web App"

[[workflows.workflow]]
name = "MIFARE Web App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34463
externalPort = 3001

[[ports]]
localPort = 37123
externalPort = 6000

[[ports]]
localPort = 37509
externalPort = 3003

[[ports]]
localPort = 37689
externalPort = 4200

[[ports]]
localPort = 39657
externalPort = 5000

[[ports]]
localPort = 39959
externalPort = 8008

[[ports]]
localPort = 42337
externalPort = 3002

[[ports]]
localPort = 43359
externalPort = 5173

[[ports]]
localPort = 43747
externalPort = 6800

[[ports]]
localPort = 44387
externalPort = 8000

[[ports]]
localPort = 46171
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["python", "app.py"]
