modules = ["web", "nodejs-20", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "gmp", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "rustc", "tcl", "tk", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MIFARE Web App"

[[workflows.workflow]]
name = "MIFARE Web App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33149
externalPort = 4200

[[ports]]
localPort = 33193
externalPort = 5000

[[ports]]
localPort = 34463
externalPort = 3001

[[ports]]
localPort = 36539
externalPort = 5173

[[ports]]
localPort = 37509
externalPort = 3003

[[ports]]
localPort = 42337
externalPort = 3002

[[ports]]
localPort = 46171
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["python", "app.py"]
